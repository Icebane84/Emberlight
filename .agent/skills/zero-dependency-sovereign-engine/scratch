//#region [SEC-05] Host Action Dispatcher & Domain Handlers
function applyToggleRow(characterId) {
	const char = sim.party.find((c) => c.id === characterId);
	if (!char) return;
	char.row = char.row === 'BACK' ? 'FRONT' : 'BACK';
	if (hostContext?.eventBus?.publish) {
		hostContext.eventBus.publish('overworld:sfx', { sfx: 'SELECT' });
		hostContext.eventBus.publish('status:updated', {
			party: structuredClone(sim.party),
		});
	}
}

function applyAdministerPotion(targetId) {
	const target = sim.party.find((c) => c.id === targetId);
	if (!target || !(target.alive ?? true) || (sim.inventory?.POTION || 0) <= 0) return;

	const maxHp = target.maxHp || 30;
	if (target.hp >= maxHp) return;

	sim.inventory.POTION -= 1;
	const healed = Math.min(25, maxHp - target.hp);
	target.hp += healed;

	if (hostContext?.eventBus?.publish) {
		hostContext.eventBus.publish('overworld:sfx', { sfx: 'HEAL' });
		hostContext.eventBus.publish('status:updated', {
			party: structuredClone(sim.party),
			inventory: structuredClone(sim.inventory),
		});
	}
}

function applyCleanseAilments(targetId) {
	const target = sim.party.find((c) => c.id === targetId);
	if (!target) return;
	target.ailments = [];
	if (hostContext?.eventBus?.publish) {
		hostContext.eventBus.publish('overworld:sfx', { sfx: 'HEAL' });
		hostContext.eventBus.publish('status:updated', {
			party: structuredClone(sim.party),
		});
	}
}

function applyExit() {
	if (hostContext?.eventBus?.publish) {
		hostContext.eventBus.publish('status:resolved', {
			party: structuredClone(sim.party),
		});
	}
}

return {
	// ... [SEC-04 Canonical 9-Methods remain unchanged] ...

	handleHostAction(action) {
		if (!action || !sim) return;

		// Handle raw string action tokens
		if (typeof action === 'string') {
			if (action === 'EXIT') applyExit();
			return;
		}

		// Route structured action objects
		switch (action.type) {
			case 'CAST_FIELD_SPELL': {
				const casterId = action['casterId'];
				const targetId = action['targetId'];
				const skillId = action['skillId'];
				if (casterId && targetId && skillId) {
					executeFieldSpell(casterId, targetId, skillId);
				}
				break;
			}

			case 'TOGGLE_ROW': {
				const charId = action['characterId'];
				if (charId) applyToggleRow(charId);
				break;
			}

			case 'ADMINISTER_POTION': {
				const targetId = action['targetId'] || action['characterId'];
				if (targetId) applyAdministerPotion(targetId);
				break;
			}

			case 'CLEANSE_AILMENTS': {
				const targetId = action['targetId'] || action['characterId'];
				if (targetId) applyCleanseAilments(targetId);
				break;
			}

			case 'NOTICE': {
				const msg = action['msg'];
				if (hostContext?.eventBus?.publish && msg) {
					hostContext.eventBus.publish('status:notice', { msg });
				}
				break;
			}

			case 'EXIT': {
				applyExit();
				break;
			}

			default:
				break;
		}
	},
};
}) ();