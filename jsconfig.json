{
  "compilerOptions": {
    "target": "es2022",
    "module": "preserve",
    "lib": [
      "es2022",
      "dom",
      "dom.iterable",
      "webworker"
    ],
    "checkJs": true,
    "strict": true,
    "strictNullChecks": true,
    "allowJs": true,
    "skipLibCheck": true
  },
  "include": [
    "globals.d.ts",
    "**/*.js",
    "**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    ".git",
    ".agents",
    ".agent",
    "tools",
    "testing",
    "data",
    "docs",
    "watch_engine.js",
    "phoenix/test_*.js"
  ]
}
