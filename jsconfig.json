{
  "compilerOptions": {
    "target": "es2022",
    "module": "none",
    "moduleResolution": "classic",
    "lib": [
      "es2022",
      "dom",
      "dom.iterable",
      "webworker"
    ],
    "checkJs": true,
    "strict": true,
    "strictNullChecks": true,
    "allowJs": true,
    "skipLibCheck": true
  },
  "include": [
    "globals.d.ts",
    "**/*.js",
    "**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    ".git",
    ".agents",
    ".agent",
    "tools",
    "testing"
  ]
}
